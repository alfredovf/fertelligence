{
  "name": "@fertelligence/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./queue": "./src/queue.ts",
    "./storage": "./src/storage.ts",
    "./health": "./src/health.ts",
    "./audit": "./src/audit.ts",
    "./files": "./src/files.ts",
    "./auth/*": "./src/auth/*.ts",
    "./services/*": "./src/services/*.ts",
    "./email/*": "./src/email/*.ts",
    "./google/*": "./src/google/*.ts",
    "./ai/*": "./src/ai/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "arctic": "^3.7.0",
    "papaparse": "^5.7.0",
    "pg-boss": "^10.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
