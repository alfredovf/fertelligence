# Copiá este archivo como .env y completá lo que tengas.
# Sin claves de Google, Claude o Resend la aplicación arranca igual, con esas funciones desactivadas.

SCHOOL_NAME="Escuela de prueba"

# Base de datos. Este valor es para correr comandos desde tu máquina (por ejemplo, migraciones);
# dentro de Docker, docker-compose.yml usa el servicio "db".
DATABASE_URL="postgresql://fertelligence:fertelligence@localhost:5432/fertelligence"

# Archivos (RustFS en local, compatible con S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fertelligence"
S3_ACCESS_KEY_ID="fertelligence"
S3_SECRET_ACCESS_KEY="fertelligence-dev-secret"


# Google: ingreso y Classroom (etapas 1 y 6)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini (etapa 5). Usá una clave de un proyecto con facturación activa (nivel pago):
# en el nivel gratuito Google puede usar los datos para mejorar sus productos.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.6-flash,gemini-3.5-flash-lite"
AI_MONTHLY_BUDGET_USD="50"

# Resend (etapa 1)
RESEND_API_KEY=""
MAIL_FROM="Fertelligence <avisos@example.com>"

# Dirección pública de la app (enlaces de los emails y retorno de Google)
APP_URL="http://localhost:3000"

# Solo para la escuela de prueba: contraseña de los usuarios de ejemplo (@escuela.test).
# Dejala vacía en una instalación real.
SEED_DEMO_PASSWORD="demo-fertelligence-2026"

# Selector de archivos de Drive (etapa 6)
GOOGLE_PICKER_API_KEY=""
GOOGLE_PROJECT_NUMBER=""

# Cifra los tokens de Google guardados en la base. Generá una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
