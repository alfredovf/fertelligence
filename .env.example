# Copiá este archivo como .env y completá lo que tengas.
# Sin claves de Google, Claude o Resend la aplicación arranca igual, con esas funciones desactivadas.

SCHOOL_NAME="Escuela de prueba"

# Base de datos. Este valor es para correr comandos desde tu máquina (por ejemplo, migraciones);
# dentro de Docker, docker-compose.yml usa el servicio "db".
DATABASE_URL="postgresql://fertelligence:fertelligence@localhost:5432/fertelligence"

# Archivos (RustFS en local, compatible con S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fertelligence"
S3_ACCESS_KEY_ID="fertelligence"
S3_SECRET_ACCESS_KEY="fertelligence-dev-secret"

# Sesiones (etapa 1). Generá uno con: openssl rand -base64 32
AUTH_SECRET=""

# Google: ingreso y Classroom (etapas 1 y 6)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Claude (etapa 5)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
AI_MONTHLY_BUDGET_USD="50"

# Resend (etapa 1)
RESEND_API_KEY=""
MAIL_FROM="Fertelligence <avisos@example.com>"
